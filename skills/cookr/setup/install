#!/usr/bin/env python3
"""Install the cookr skill globally for the current user.

- Installs the cookr CLI via the repo's ./install --cli-only:
  ~/.local/bin/cookr and ~/.local/bin/_cookr_pkg/.
- Copies SKILL.md to ~/.claude/skills/cookr/, so the skill is /cookr in every
  project.

--skill-only skips the CLI step; the repo's ./install uses it, having just
installed the CLIs itself.

Idempotent. Re-run to refresh after edits. Reverse with ./uninstall.
"""

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

SKILL_SRC = Path(__file__).resolve().parent.parent
REPO_ROOT = SKILL_SRC.parent.parent
sys.path.insert(0, str(REPO_ROOT))
sys.dont_write_bytecode = True  # keep the checkout free of __pycache__/

from setup_support import CLAUDE_DIR, ok, title  # noqa: E402

SKILL_DST = CLAUDE_DIR / "skills" / "cookr"


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="install", description=__doc__.splitlines()[0])
    parser.add_argument("--skill-only", action="store_true", help="skip installing the CLIs")
    args = parser.parse_args(argv)

    if not args.skill_only:
        cli = subprocess.run([sys.executable, str(REPO_ROOT / "install"), "--cli-only"])
        if cli.returncode != 0:
            return cli.returncode

    title("Installing cookr skill")
    shutil.rmtree(SKILL_DST, ignore_errors=True)
    SKILL_DST.mkdir(parents=True)
    shutil.copy2(SKILL_SRC / "SKILL.md", SKILL_DST / "SKILL.md")
    ok(f"skill → {SKILL_DST}")

    if not args.skill_only:
        title("Done")
        ok("Run: cookr --help")
        ok("Restart your Claude Code session to pick up /cookr.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
