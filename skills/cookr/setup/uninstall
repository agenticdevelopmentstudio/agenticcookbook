#!/usr/bin/env python3
"""Remove what ./install placed for cookr.

- Removes the ~/.claude/skills/cookr/ skill
- Removes the cookr CLI shim and package from ~/.local/bin

Leaves the cookbook CLI installed: it is shared with the cookbook skill and
the adh plugin. The repo's root ./uninstall removes it. Also leaves the
pip-installed deps (rich, questionary, pyyaml), which other tools may use.
"""

import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(REPO_ROOT))
sys.dont_write_bytecode = True  # keep the checkout free of __pycache__/

from setup_support import BIN_DIR, CLAUDE_DIR, ok, remove, title  # noqa: E402

SKILL_DST = CLAUDE_DIR / "skills" / "cookr"


def main() -> int:
    title("Removing cookr skill")
    remove(SKILL_DST)

    title("Removing cookr CLI")
    remove(BIN_DIR / "cookr")
    remove(BIN_DIR / "_cookr_pkg")

    title("Done")
    ok("cookbook CLI and Python deps left installed (shared; the repo's ./uninstall removes the CLI)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
