#!/usr/bin/env python3
"""Remove everything ./install placed on the system.

- Runs each standalone skill's own skills/<name>/setup/uninstall
- Removes each CLI skill's shim and package (recorded by ./install, or in the layout)
- Removes what earlier layouts installed: the adh plugin's marketplace
  registration, its assembled plugins/ directory, and the legacy
  ~/.claude/skills/cookbook/ location

Does NOT uninstall pip-installed deps (rich, questionary, pyyaml) — those may
be used by other tools.
"""

from __future__ import annotations

import subprocess
import sys

sys.dont_write_bytecode = True  # keep the checkout free of __pycache__/

from setup_support import (
    CLI_RECORD,
    SKILLS_SRC,
    cli_skills,
    ok,
    recorded_cli_skills,
    remove_cli,
    retire,
    standalone_skills,
    title,
)


def skills_to_remove() -> list[str]:
    """Those ./install recorded installing, plus those the layout carries now,
    so an install that predates the record is covered."""
    return list(dict.fromkeys([*recorded_cli_skills(), *cli_skills()]))


def main() -> int:
    for skill in standalone_skills():
        subprocess.run([sys.executable, str(SKILLS_SRC / skill / "setup" / "uninstall")], check=True)
    for skill in skills_to_remove():
        title(f"Removing {skill} CLI")
        remove_cli(skill)
    CLI_RECORD.unlink(missing_ok=True)

    title("Removing earlier layouts")
    retire()

    title("Done")
    ok("rich / questionary / pyyaml were left installed (may be used by other tools)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
